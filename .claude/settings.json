    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/roshansanjeev/Desktop/Gallo/GalloSanitizationMVP && npx vitest run --reporter=verbose 2>&1 | tail -30; echo '---'; npx playwright test --reporter=line 2>&1 | tail -30",
